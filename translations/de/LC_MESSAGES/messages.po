#: /home/markus/InvenioRDM/safe/datasafe-rdm/site/datasafe_rdm/templates/semantic-ui/datasafe_rdm/privacy.html:65
msgid ""
"Scope of data processing<br>The following personal data from you and all "
"further persons that have been appointed by you is processed in "
"connection with the archiving of your digital research data:"
msgstr ""
"Umfang der Datenverarbeitung<br>Im Rahmen der Archivierung digitaler "
"Forschungsdaten verarbeiten wir von Ihnen und allen weiteren von Ihnen "
"benannten Personen die folgenden Daten:"

#: /home/markus/InvenioRDM/safe/datasafe-rdm/site/datasafe_rdm/templates/semantic-ui/datasafe_rdm/privacy.html:69
msgid "First name"
msgstr "Vorname"

#: /home/markus/InvenioRDM/safe/datasafe-rdm/site/datasafe_rdm/templates/semantic-ui/datasafe_rdm/privacy.html:69
msgid "Family name"
msgstr "Nachname"

#: /home/markus/InvenioRDM/safe/datasafe-rdm/site/datasafe_rdm/templates/semantic-ui/datasafe_rdm/privacy.html:70
#: /home/markus/InvenioRDM/safe/datasafe-rdm/templates/semantic-ui/invenio_userprofiles/settings/profile.html:50
