{% set submission_request = notification.context.request %}
{% set community = submission_request.receiver %}
{% set access_visibility = community.access.visibility %}
{% set record = submission_request.topic %}
{% set further_involved_users = submission_request.further_involved_users %}
{% set metadata = record.metadata %}
{% set publication_date = metadata.publication_date %}
{% set title = metadata.title %}
{% set vars = {"subtitle": "-", "size": 0} %}
{% for additional_title in metadata.additional_titles %}
  {% set test = vars.update({"subtitle": additional_title.title }) if additional_title.type.id == "subtitle" %}
{% endfor %}
{% set creator = submission_request.created_by %}
{% set embargo_until = record.access.embargo.until %}
{% set embargo_active = record.access.embargo.active %}
{% set doi = record.pids.doi %}
{% set files = record.files.entries %}
{% for key, value in files.items() %}
  {% set s = vars.size + value.size %}
  {% set test = vars.update({"size": s }) %}
{% endfor %}

{% set logo_name = "datasafe-logo" if access_visibility == "restricted" else "datastore-logo" %}
{% set cert_subject = "Archiving" if access_visibility == "restricted" else "Publication" %}
{% set data = "dataset" if access_visibility == "restricted" else "publication" %}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta http-equiv="content-type" content="text/html; charset=utf-8" />
  <style>
      @page {
          @bottom-right {
              content: "Receipt for: '{{ title|truncate(25, True, '...') }}' - page " counter(page) " of " counter(pages);;
          }
      }
  </style>
</head>
<body>
<table id="tabelle_seitenkopf">
  <tr>
    <!-- TODO: add your own institution's logo here -->
    <td id="zelle_rdm_logo"><img
      src="data:image/svg+xml;base64,"
      id="img_rdm_logo" alt="" /></td>
  </tr>
  <tr>
    <td></td>
    <td class="absender">
      
      <!-- TODO: your own contact address -->
      <a href="mailto:support@example.org">support@example.org</a>
    </td>
  </tr>
  <tr>
    <td></td>
    <td class="datum"><strong>Date</strong><br />{{ publication_date|datetime_format }}</td>
  </tr>
</table>

<p class="betreff">{{ cert_subject }} of your research data: Confirmation of receipt</p>
<br>
<p>To whom it may concern,</p>
<p class="haupttext">
  You uploaded data to <em>datasafe</em>, a service of the University of Münster for archiving research data.
  Only you and the persons listed below are authorized to download this data after authentication with their
  university ID.</p>
<p id="warntext">Please note: The research data is stored for ten years before being erased.</p>
<p class="grussformel">Yours faithfully<br />Service Center for Data Management</p>
<hr class="light" />
<div id="div_metadaten">
  <table id="tabelle_allgemeine_metadaten">
    <tr>
      <td class="feldnamen">Title</td>
      <td>{{ title }}</td>
    </tr>
    <tr>
      <td class="feldnamen">Subtitle</td>
      <td>{{ vars.subtitle }}</td>
    </tr>
    <tr>
      <td class="feldnamen">Size</td>
      <td>{{ vars.size|unit_calculator }}</td>
    </tr>
    <tr>
      <td class="feldnamen">Storage period</td>
      <td>{{ record.updated|datetime_format }}
        &#x2002;&#x2013;&#x2002; {{ record.custom_fields["datasafe:planned_purge_date"]|datetime_format }}</td>
    </tr>
    <tr>
      <td class="feldnamen">Link</td>
      <td><a href="{{ record.links.self_html }}">{{ record.links.self_html }}</a>
      </td>
    </tr>
  </table>

  {% if further_involved_users|length > 0 %}
  {% endif %}
  <p class="titel_autoren_metadaten">Dataset Owner</p>
  <p class="name_autor">{{ creator.profile.full_name }}</p>
  {% if creator.profile.affiliations %}
    <p class="adresse_autor">{{ creator.profile.affiliations }}</p>
  {% else %}
    <p class="adresse_autor"></p>
  {% endif %}
  {% if further_involved_users|length > 0 %}
    <div id="further_involved_users">
      <p class="titel_autoren_metadaten">Further involved persons</p>
      {% for user in further_involved_users %}
        <p class="name_autor">{{ user.full_name }}</p>
        {% if user.affiliations %}
          <p class="adresse_autor">{{ user.affiliations }}</p>
        {% else %}
          <p id="adresse_autor"></p>
        {% endif %}
        {% if (loop.index + 1) % 16 == 0 %}
          </div>
        {% endif %}
      {% endfor %}
  {% endif %}
</div>
</body>
</html>

