/*******************************
         Modal Overrides
*******************************/
@import "../globals/site.variables";


.ui.modal {
  h2.header {
    padding-bottom: 1rem;
  }

  .content {
    padding: 0 1.5em .5em 1.5em;
  }
}

@media only screen and (max-width: 1279px) {
  .ui.modal > .close {
    top: 1rem;
    right: 1rem;
  }
}